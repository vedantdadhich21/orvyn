# Base Mainnet read-only phase
# Reads can be enabled without any mainnet transaction.
MAINNET_READS_ENABLED=false

# Writes stay off. Both flags must be true before any future write path can run.
MAINNET_WRITES_ENABLED=false
MAINNET_WRITES_APPROVED=false

# Builder Code attribution and proof transactions stay off until approved.
BUILDER_PROOF_ENABLED=false

# Server-only RPC configuration. Never prefix these with NEXT_PUBLIC_.
BASE_MAINNET_RPC_URL=
BASE_MAINNET_RPC_FALLBACKS=

# Public attribution identifier from Base Dashboard. Not a secret.
NEXT_PUBLIC_BUILDER_CODE=
