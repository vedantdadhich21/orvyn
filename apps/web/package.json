    "contracts:deploy": "bun run scripts/deploy-registry.ts",
    "launch:artifacts": "bun run scripts/compile-launch.ts",
    "launch:deploy": "bun run scripts/deploy-launch.ts",
    "launch:basket": "bun run scripts/buy-basket.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
