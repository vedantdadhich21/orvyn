    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "solc": "0.8.24",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  }
