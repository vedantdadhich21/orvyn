    "@privy-io/wagmi": "^4.0.17",
    "@tanstack/react-query": "^5.102.8",
    "@tradetoken/design-tokens": "workspace:*",
    "@tradetoken/domain": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "ox": "^1.9.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.21.0",
    "snaptrade-typescript-sdk": "^12.2.0",
